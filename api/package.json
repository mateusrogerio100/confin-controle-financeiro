{
  "name": "confin-api",
  "version": "1.0.0",
  "description": "API do ConFin - Sistema de Controle Financeiro Familiar",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:local": "node scripts/local-db.js",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.js",
    "db:seed-sql": "node scripts/seed-sql.js",
    "test:smoke": "node scripts/smoke-test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "embedded-postgres": "^18.6.0-beta.19"
  }
}
