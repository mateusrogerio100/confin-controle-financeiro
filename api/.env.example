# Banco local (npm run db:local). Em produção use a URL do Neon/Supabase.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/confin
# true quando o banco exigir SSL (Neon/Supabase)
DATABASE_SSL=false
# Troque por um valor longo e aleatório em produção
JWT_SECRET=troque-este-segredo
PORT=3333
# Origem do front em desenvolvimento (Vite)
CORS_ORIGIN=http://localhost:5173
